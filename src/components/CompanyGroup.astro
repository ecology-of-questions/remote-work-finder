---
import type { Experience, Job } from "../lib/types";
import JobCard from "./JobCard.astro";

interface Props {
  company: string;
  jobs: Job[];
  experiences: Experience[];
}

const { company, jobs, experiences } = Astro.props;
---

<section class="group" data-company={company}>
  <header class="head">
    <h2 class="name">{company}</h2>
    <span class="count"><span data-company-count>{jobs.length}</span>件</span>
    <button type="button" class="save" data-save={`company:${company}`} aria-pressed="false">
      <span class="save-off">＋ 会社を保存</span><span class="save-on">保存済みの会社</span>
    </button>
  </header>
  <div class="jobs">
    {jobs.map((job) => <JobCard job={job} experiences={experiences} />)}
  </div>
</section>

<style>
  .group {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2);
  }

  .name {
    flex: 1 1 100%;
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-accent);
  }

  .count {
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .save {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .save-on,
  .save[aria-pressed="true"] .save-off {
    display: none;
  }

  .save[aria-pressed="true"] .save-on {
    display: inline;
  }

  .jobs {
    display: grid;
    gap: var(--space-4);
  }
</style>
