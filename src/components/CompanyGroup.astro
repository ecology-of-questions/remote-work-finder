---
import type { Company, Experience, Job } from "../lib/types";
import { companyPath } from "../lib/data";
import JobCard from "./JobCard.astro";
import SaveCompanyButton from "./SaveCompanyButton.astro";

interface Props {
  company: Company;
  jobs: Job[];
  experiences: Experience[];
}

const { company, jobs, experiences } = Astro.props;
---

<section class="group" data-company={company.name}>
  <header class="head">
    <h2 class="name"><a href={companyPath(company)}>{company.name}</a></h2>
    <span class="count"><span data-company-count>{jobs.length}</span>件</span>
    <SaveCompanyButton company={company} />
  </header>
  <div class="jobs">
    {jobs.map((job) => <JobCard job={job} experiences={experiences} />)}
  </div>
</section>

<style>
  .group {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2);
  }

  .name {
    flex: 1 1 100%;
    margin: 0;
    font-size: var(--text-lg);
  }

  .name a {
    color: var(--color-accent);
  }

  .count {
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .jobs {
    display: grid;
    gap: var(--space-4);
  }
</style>
