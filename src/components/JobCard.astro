---
import type { Job } from "../lib/types";
import { formatPay, formatWeeklyHours } from "../lib/format";
import JobDetail from "./JobDetail.astro";
import type { Experience } from "../lib/types";

interface Props {
  job: Job;
  /** この会社の確認済み体験談 */
  experiences: Experience[];
}

const { job, experiences } = Astro.props;

const tags = [
  job.employmentType,
  job.english === true ? "英語力が必要" : job.english === false ? "英語不要" : null,
  job.speaking === true ? "発話あり" : null,
  job.phone === false && job.meetings === false ? "電話・会議なし" : null,
  job.flexibleSchedule === true ? "時間は自由" : null,
].filter((t): t is string => t !== null);
---

<article class="card" data-job-id={job.id}>
  {job.kind === "pool" && <span class="badge">登録先</span>}
  <h3 class="title">{job.title}</h3>
  <p class="summary">{job.summary}</p>
  <p class="pay">{formatPay(job.pay)}</p>
  <p class="hours">{formatWeeklyHours(job.weeklyHours)}</p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }
  <div class="actions">
    <button type="button" class="detail" data-open-dialog={job.id}>詳細・テスト →</button>
    <button type="button" class="save" data-save={`job:${job.id}`} aria-pressed="false">
      <span class="save-off">＋ 保存</span><span class="save-on">保存済み</span>
    </button>
  </div>

  <dialog class="dialog" data-dialog={job.id} aria-labelledby={`dialog-title-${job.id}`}>
    <header class="dialog-head">
      <h2 id={`dialog-title-${job.id}`}>{job.title}</h2>
      <button type="button" class="close" data-close-dialog aria-label="閉じる">×</button>
    </header>
    <div class="dialog-body">
      <JobDetail job={job} experiences={experiences} />
    </div>
  </dialog>
</article>

<style>
  .card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .badge {
    justify-self: end;
    padding: var(--space-1) var(--space-3);
    background: var(--color-badge);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .summary,
  .hours {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .pay {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .actions {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .actions button {
    padding: var(--space-2) 0;
    background: none;
    border: none;
    cursor: pointer;
    font-size: var(--text-sm);
  }

  .detail {
    font-weight: 700;
    color: var(--color-accent);
  }

  .save {
    color: var(--color-text-muted);
  }

  .save-on,
  .save[aria-pressed="true"] .save-off {
    display: none;
  }

  .save[aria-pressed="true"] .save-on {
    display: inline;
    color: var(--color-accent);
    font-weight: 700;
  }

  .dialog {
    width: min(100% - 2 * var(--space-4), var(--content-width));
    max-height: min(90dvh, 100%);
    padding: 0;
    background: var(--color-bg);
    color: var(--color-text);
    border: none;
    border-radius: var(--radius-md);
  }

  .dialog::backdrop {
    background: var(--color-overlay);
  }

  .dialog[open] {
    display: flex;
    overflow: hidden;
    flex-direction: column;
  }

  .dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .dialog-head h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .close {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    font-size: var(--text-lg);
    color: var(--color-accent);
    cursor: pointer;
  }

  .dialog-body {
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-5);
  }
</style>
