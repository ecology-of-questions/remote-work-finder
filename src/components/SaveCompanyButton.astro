---
import type { Company } from "../lib/types";

interface Props {
  company: Company;
}

const { company } = Astro.props;
---

<button type="button" class="save" data-save={`company:${company.name}`} aria-pressed="false">
  <span class="save-off">＋ 会社を保存</span><span class="save-on">保存済みの会社</span>
</button>

<style>
  .save {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .save-on,
  .save[aria-pressed="true"] .save-off {
    display: none;
  }

  .save[aria-pressed="true"] .save-on {
    display: inline;
  }
</style>
