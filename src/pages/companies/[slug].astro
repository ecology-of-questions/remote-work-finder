---
import Layout from "../../layouts/Layout.astro";
import JobCard from "../../components/JobCard.astro";
import ExperienceList from "../../components/ExperienceList.astro";
import SaveCompanyButton from "../../components/SaveCompanyButton.astro";
import { experiencesOf, jobsOf, listedCompanies } from "../../lib/data";
import type { Company } from "../../lib/types";

export function getStaticPaths() {
  return listedCompanies.map((company) => ({ params: { slug: company.slug }, props: { company } }));
}

interface Props {
  company: Company;
}

const { company } = Astro.props;
const jobs = jobsOf(company);
const experiences = experiencesOf(company);

const facts = [
  { label: "支払い方法", value: company.payment },
  { label: "支払いの頻度", value: company.payout },
  { label: "応募の流れ", value: company.hiring },
];
---

<Layout
  title={`${company.name} のフルリモートの仕事`}
  description={`${company.name} の在宅・フルリモートの求人${jobs.length}件と、支払い方法・応募の流れ。`}
>
  <main class="page">
    <a class="back" href="/">← すべての仕事</a>

    <header class="head">
      <h1>{company.name}</h1>
      <SaveCompanyButton company={company} />
    </header>

    <section class="box" aria-labelledby="about-title">
      <h2 id="about-title" class="visually-hidden">会社について</h2>
      <p>{company.about}</p>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value ?? "未確認"}</dd>
            </div>
          ))
        }
      </dl>
      {
        company.notes.length > 0 && (
          <ul class="notes">
            {company.notes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        )
      }
      <p class="source">
        公式サイト：<a href={company.website} target="_blank" rel="noopener noreferrer">{new URL(company.website).hostname}</a>
        <br />
        出典：{
          company.sourceUrls.map((u, i) => (
            <>
              {i > 0 && "、"}
              <a href={u} target="_blank" rel="noopener noreferrer">
                {new URL(u).hostname + new URL(u).pathname}
              </a>
            </>
          ))
        }（{company.checkedAt} 確認）
      </p>
    </section>

    <section class="jobs" aria-labelledby="jobs-title">
      <h2 id="jobs-title">求人 <span class="count">{jobs.length}件</span></h2>
      {jobs.map((job) => <JobCard job={job} experiences={experiences} />)}
    </section>

    <ExperienceList
      groupId={`company-${company.slug}`}
      experiences={experiences}
      lead="この会社についての投稿です。"
    />
  </main>
</Layout>

<script>
  import "../../scripts/interactions";
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    width: min(100% - 2 * var(--space-4), var(--content-width));
    margin: 0 auto;
    padding: var(--space-6) 0 var(--space-7);
  }

  .back {
    font-size: var(--text-sm);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .head h1 {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--color-accent);
  }

  .box {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .box p {
    margin: 0;
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .facts div {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .facts dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .facts dd {
    margin: var(--space-1) 0 0;
  }

  .notes {
    margin: 0;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
  }

  .box .source {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .jobs {
    display: grid;
    gap: var(--space-4);
  }

  .jobs h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .count {
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-muted);
  }
</style>
